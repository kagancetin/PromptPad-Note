{
  "name": "promptpad-note",
  "version": "1.0.1",
  "description": "Pluggable & Headless Note & Prompt Management for Node.js (MongoDB) and React",
  "type": "module",
  "main": "./shared/dist/index.js",
  "types": "./shared/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./shared/dist/index.d.ts",
      "default": "./shared/dist/index.js"
    },
    "./server": {
      "types": "./server/dist/index.d.ts",
      "default": "./server/dist/index.js"
    },
    "./react": {
      "types": "./client/dist/index.d.ts",
      "import": "./client/dist/index.js",
      "require": "./client/dist/index.cjs"
    },
    "./react/style.css": "./client/dist/style.css"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./server/dist/index.d.ts"
      ],
      "react": [
        "./client/dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix shared && npm run build --prefix server && npm run build --prefix client",
    "install:all": "npm install && npm install --prefix shared && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "mongoose": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "files": [
    "shared/dist",
    "server/dist",
    "client/dist"
  ]
}